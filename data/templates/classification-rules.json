{
  "version": 2,
  "description": "Editable vendor/transaction classification rules. Public template only — no live financial data.",
  "promotionPolicy": "After the owner approves the same reliable vendor rule repeatedly (autoPromoteAfterApprovals), it may become an automatic proposal rule. Merchant name alone never authorizes posting.",
  "creditCardDistinction": {
    "summary": "Do not treat all credit-card transactions as transfers. Merchant charges remain expenses or asset candidates per approved classifications. Only verified card-balance settlements are transfers from a funding bank to the card liability, not additional expenses.",
