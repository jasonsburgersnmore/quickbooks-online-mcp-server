      "ONLINE ACH PAYMENT THANK YOU",
      "AUTOPAY PAYMENT RECEIVED"
    ],
    "paymentPostingGates": [
      "matching amount",
      "date or date window",
      "source bank / funding account identified",
      "credit-card liability destination confirmed"
    ],
    "neverApplyBasedOn": ["the words credit card alone", "merchant card purchases", "presence of a credit-card liability account"]
  },
